# ============================================================
# multi-agent 环境配置模板（v2.2 环境策略：配置驱动切换）
# 用法：
#   本地开发 → 复制为 .env.dev 填写
#   云端部署 → 复制为 .env.prod 填写
#   同一套 docker-compose.yml，只换 --env-file 指向
#   密钥一律不入 git（.env* 已在 .gitignore）
# ============================================================

# ── 运行环境 ──
# dev / prod，控制 core/paths.py 路径探测与日志级别
APP_ENV=dev

# ── LLM 多 provider（全部走 OpenAI 兼容协议）──
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包（火山方舟）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# 智谱
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

# 默认模型 provider（deepseek / ark / zhipu）
LLM_PROVIDER=deepseek

# ── 沙箱（OpenSandbox server）──
# 本地开发：docker compose 起本地服务 → SANDBOX_URL=http://localhost:8080
# 生产部署：连云端已部署的 server → SANDBOX_URL=http://<云端IP>:<端口>
SANDBOX_URL=http://localhost:8080
SANDBOX_API_KEY=
SANDBOX_PORT=8080

# ── Redis（短期记忆）──
# 空密码则不启用 requirepass
REDIS_PASSWORD=

# ── 记忆/存储 ──
# 本地开发连本地 docker redis（compose 映射 6398，避开 Clowder 6399）；生产连云端
REDIS_URL=redis://localhost:6398/0

# ── PostgreSQL（2026-10-15 PG 迁移：业务库 + LangGraph 断点/记忆库）──
# 本地 compose 起 pgvector/pgvector:pg16，对外 5433 → 容器 5432（避开本机 5432）
# POSTGRES_* 供 compose 初始化实例；PG_DSN 供后端连接池（db/connection.py）
# 生产：PG_DSN 的 host 换成云端 PG 地址（compose 内起库时为服务名 postgres）
POSTGRES_USER=multi_agent
POSTGRES_PASSWORD=
POSTGRES_DB=multi_agent
POSTGRES_PORT=5433
PG_DSN=postgresql://multi_agent:<password>@localhost:5433/multi_agent

# ── 监控 ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent

# ── 工具 API（第三方检索等）──
TAVILY_API_KEY=

# ── Web ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── MCP ──
MCP_HOST=0.0.0.0
MCP_PORT=9000
