# ============================================================
# multi-agent 环境配置模板（v2.2 环境策略：配置驱动切换）
# 用法：
#   本地开发 → 复制为 .env.dev 填写
#   云端部署 → 复制为 .env.prod 填写
#   同一套 docker-compose.yml，只换 --env-file 指向
#   密钥一律不入 git（.env* 已在 .gitignore）
# ============================================================

# ── 运行环境 ──
# dev / prod，控制 core/paths.py 路径探测与日志级别
APP_ENV=dev

# ── LLM 多 provider（全部走 OpenAI 兼容协议）──
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 豆包（火山方舟）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# 智谱
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

# 默认模型 provider（deepseek / ark / zhipu）
LLM_PROVIDER=deepseek

# ── 沙箱（云端 OpenSandbox，本地不部署）──
SANDBOX_URL=http://<云端IP>:<端口>
SANDBOX_API_KEY=
SANDBOX_PORT=8080
# 本地连云端时无需额外配置；SDK 通过 SANDBOX_URL 连接

# ── Redis（短期记忆）──
# 空密码则不启用 requirepass
REDIS_PASSWORD=

# ── 记忆/存储 ──
# 云端 Redis（短期记忆）；本地开发也可指本地 docker redis
REDIS_URL=redis://localhost:6379/0
# SQLite（长期记忆）
DB_PATH=./data/wiki.db

# ── 监控 ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent

# ── Web ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── MCP ──
MCP_HOST=0.0.0.0
MCP_PORT=9000
